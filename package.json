{
  "name": "dare-me",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.mjs\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "python3 tests/ui_smoke.py",
    "format": "prettier --write src server tests/api.test.mjs vite.config.ts index.html package.json tsconfig.json README.md",
    "build:demo": "tsc -b && vite build --mode demo",
    "preview:demo": "vite preview --mode demo --host 0.0.0.0 --port 4173",
    "deploy:demo": "npm run build:demo && node scripts/publish-demo.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "railway": "^3.16.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
